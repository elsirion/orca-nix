@@ -0,0 +1,74 @@
+import { delimiter } from 'node:path'
+import { describe, expect, it, vi } from 'vitest'
+import type { ProcessResult } from '../../shared/child-process/process-spec'
+import { allowDirenvForWorktree } from './direnv-worktree-allow'
+
+function exited(overrides: Partial<ProcessResult> = {}): ProcessResult {
+  return { code: 0, signal: null, stdout: '', stderr: '', timedOut: false, ...overrides }
+}
+
+function okRun() {
+  return vi.fn(async () => exited())
+}
+
+describe('allowDirenvForWorktree', () => {
+  it('runs `direnv allow` on the worktree .envrc with the shell PATH', async () => {
+    const run = okRun()
+    await expect(
+      allowDirenvForWorktree('/w/feature', {
+        platform: 'linux',
+        exists: (path) => path === '/w/feature/.envrc',
+        pathSegments: async () => ['/home/u/.nix-profile/bin', '/usr/bin'],
+        run
+      })
+    ).resolves.toBe('allowed')
+    expect(run).toHaveBeenCalledWith(
+      expect.objectContaining({
+        program: 'direnv',
+        args: ['allow', '/w/feature/.envrc'],
+        cwd: '/w/feature',
+        env: expect.objectContaining({
+          PATH: ['/home/u/.nix-profile/bin', '/usr/bin'].join(delimiter)
+        })
+      })
+    )
+  })
+
+  it('does nothing without an .envrc or on Windows', async () => {
+    const run = okRun()
+    await expect(
+      allowDirenvForWorktree('/w/feature', { platform: 'linux', exists: () => false, run })
+    ).resolves.toBe('no-envrc')
+    await expect(
+      allowDirenvForWorktree('/w/feature', { platform: 'win32', exists: () => true, run })
+    ).resolves.toBe('unsupported-platform')
+    expect(run).not.toHaveBeenCalled()
+  })
+
+  it('reports a missing direnv without warning and a failure with a warning', async () => {
+    const warn = vi.fn()
+    const missing = Object.assign(new Error('spawn direnv ENOENT'), { code: 'ENOENT' })
+    await expect(
+      allowDirenvForWorktree('/w/feature', {
+        platform: 'linux',
+        exists: () => true,
+        pathSegments: async () => [],
+        run: vi.fn(async () => {
+          throw missing
+        }),
+        warn
+      })
+    ).resolves.toBe('direnv-missing')
+    expect(warn).not.toHaveBeenCalled()
+    await expect(
+      allowDirenvForWorktree('/w/feature', {
+        platform: 'linux',
+        exists: () => true,
+        pathSegments: async () => [],
+        run: vi.fn(async () => exited({ code: 1, stderr: 'boom\n' })),
+        warn
+      })
+    ).resolves.toBe('failed')
+    expect(warn).toHaveBeenCalledWith('direnv allow failed for /w/feature/.envrc: boom')
+  })
+})
diff --git a/src/main/direnv/direnv-worktree-allow.ts b/src/main/direnv/direnv-worktree-allow.ts
new file mode 100644
index 0000000000..5c52c326e7
--- /dev/null
+++ b/src/main/direnv/direnv-worktree-allow.ts
@@ -0,0 +1,75 @@
+import { existsSync } from 'node:fs'
+import { delimiter, join } from 'node:path'
+import { runProcess } from '../../shared/child-process/run-process'
+import { hydrateShellPath } from '../startup/hydrate-shell-path'
+
+const DIRENV_ALLOW_TIMEOUT_MS = 10_000
+
+export type DirenvAllowOutcome =
+  | 'allowed'
+  | 'no-envrc'
+  | 'direnv-missing'
+  | 'failed'
+  | 'unsupported-platform'
+
+export type DirenvAllowDeps = {
+  platform?: NodeJS.Platform
+  exists?: (path: string) => boolean
+  pathSegments?: () => Promise<readonly string[]>
+  run?: typeof runProcess
+  warn?: (message: string) => void
+}
+
+/** Why: the main process PATH is often narrower than the user's shell PATH, where direnv lives. */
+async function defaultPathSegments(): Promise<readonly string[]> {
+  const hydrated = await hydrateShellPath()
+  const processSegments = (process.env.PATH ?? '').split(delimiter)
+  return hydrated.ok ? [...hydrated.segments, ...processSegments] : processSegments
+}
+
+function isMissingExecutable(error: unknown): boolean {
+  return typeof error === 'object' && error !== null && 'code' in error && error.code === 'ENOENT'
+}
+
+/**
+ * Allows a freshly created worktree's `.envrc`, the way workspacer's `ws` does on entering a
+ * workspace. direnv keys its allow list by path and content, so a new checkout of an already
+ * trusted `.envrc` still starts blocked; without this every new worktree needs a manual
+ * `direnv allow` before shells and agents load the project environment.
+ */
+export async function allowDirenvForWorktree(
+  worktreePath: string,
+  deps: DirenvAllowDeps = {}
+): Promise<DirenvAllowOutcome> {
+  const platform = deps.platform ?? process.platform
+  const exists = deps.exists ?? existsSync
+  const warn = deps.warn ?? ((message: string) => console.warn(message))
+  if (platform === 'win32') {
+    return 'unsupported-platform'
+  }
+  const envrcPath = join(worktreePath, '.envrc')
+  if (!exists(envrcPath)) {
+    return 'no-envrc'
+  }
+  const segments = await (deps.pathSegments ?? defaultPathSegments)()
+  try {
+    const result = await (deps.run ?? runProcess)({
+      program: 'direnv',
+      args: ['allow', envrcPath],
+      cwd: worktreePath,
+      env: { ...process.env, PATH: segments.join(delimiter) },
+      timeoutMs: DIRENV_ALLOW_TIMEOUT_MS
+    })
+    if (result.code === 0) {
+      return 'allowed'
+    }
+    warn(`direnv allow failed for ${envrcPath}: ${result.stderr.trim()}`)
+    return 'failed'
+  } catch (error) {
+    if (isMissingExecutable(error)) {
+      return 'direnv-missing'
+    }
+    warn(`direnv allow failed for ${envrcPath}: ${String(error)}`)
+    return 'failed'
+  }
+}
diff --git a/src/main/git/worktree-add-direnv-allow.test.ts b/src/main/git/worktree-add-direnv-allow.test.ts

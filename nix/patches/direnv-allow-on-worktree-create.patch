@@ -0,0 +1,75 @@
+// addWorktree: a fresh checkout gets its .envrc allowed; --no-checkout and WSL checkouts do not.
+import { afterEach, beforeEach, describe, expect, it, vi, type MockInstance } from 'vitest'
+
+const { gitExecFileAsyncMock, gitExecFileSyncMock, allowDirenvForWorktreeMock } = vi.hoisted(
+  () => ({
+    gitExecFileAsyncMock: vi.fn(),
+    gitExecFileSyncMock: vi.fn(),
+    allowDirenvForWorktreeMock: vi.fn(async () => 'allowed' as const)
+  })
+)
+
+vi.mock('./runner', () => ({
+  gitExecFileAsync: gitExecFileAsyncMock,
+  gitExecFileSync: gitExecFileSyncMock,
+  translateWslOutputPaths: vi.fn((output: string) => output)
+}))
+
+vi.mock('../direnv/direnv-worktree-allow', () => ({
+  allowDirenvForWorktree: allowDirenvForWorktreeMock
+}))
+
+import { addWorktree } from './worktree'
+import { registerWorktreeSuiteHooks } from './worktree-test-harness'
+
+registerWorktreeSuiteHooks()
+
+describe('addWorktree direnv allow', () => {
+  let platformSpy: MockInstance<() => NodeJS.Platform>
+
+  beforeEach(() => {
+    gitExecFileAsyncMock.mockReset()
+    gitExecFileSyncMock.mockReset()
+    allowDirenvForWorktreeMock.mockClear()
+    platformSpy = vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+  })
+
+  afterEach(() => {
+    platformSpy.mockRestore()
+  })
+
+  it('allows the new checkout after an existing-branch add', async () => {
+    gitExecFileAsyncMock.mockResolvedValueOnce({ stdout: '' }) // worktree add
+    await addWorktree('/repo', '/repo-feature', 'feature/test', 'feature/test', false, false, {
+      checkoutExistingBranch: true
+    })
+    expect(allowDirenvForWorktreeMock).toHaveBeenCalledWith('/repo-feature')
+  })
+
+  it('skips --no-checkout adds, which have no .envrc yet', async () => {
+    gitExecFileAsyncMock.mockResolvedValueOnce({ stdout: '' }) // worktree add
+    await addWorktree('/repo', '/repo-feature', 'feature/test', 'feature/test', false, true, {
+      checkoutExistingBranch: true
+    })
+    expect(allowDirenvForWorktreeMock).not.toHaveBeenCalled()
+  })
+
+  it('leaves WSL checkouts to the distro direnv', async () => {
+    gitExecFileAsyncMock.mockResolvedValueOnce({ stdout: '' }) // worktree add
+    await addWorktree('/repo', '/repo-feature', 'feature/test', 'feature/test', false, false, {
+      checkoutExistingBranch: true,
+      wslDistro: 'Ubuntu'
+    })
+    expect(allowDirenvForWorktreeMock).not.toHaveBeenCalled()
+  })
+
+  it('does not allow anything when the add itself fails', async () => {
+    gitExecFileAsyncMock.mockRejectedValueOnce(new Error('worktree add failed'))
+    await expect(
+      addWorktree('/repo', '/repo-feature', 'feature/test', 'feature/test', false, false, {
+        checkoutExistingBranch: true
+      })
+    ).rejects.toThrow('worktree add failed')
+    expect(allowDirenvForWorktreeMock).not.toHaveBeenCalled()
+  })
+})

+import { describe, expect, it } from 'vitest'
+import { resolveWorktreeCardAttentionTone } from './worktree-card-attention'
+
+describe('resolveWorktreeCardAttentionTone', () => {
+  it('tints the card for a live permission request regardless of unread', () => {
+    expect(resolveWorktreeCardAttentionTone('permission', false)).toBe('question')
+    expect(resolveWorktreeCardAttentionTone('permission', true)).toBe('question')
+  })
+
+  it('tints unread cards once no live turn owns the status', () => {
+    expect(resolveWorktreeCardAttentionTone('done', true)).toBe('unread')
+    expect(resolveWorktreeCardAttentionTone('active', true)).toBe('unread')
+    expect(resolveWorktreeCardAttentionTone('inactive', true)).toBe('unread')
+    expect(resolveWorktreeCardAttentionTone('interrupted', true)).toBe('unread')
+  })
+
+  it('lets a live working turn suppress the stale unread tint', () => {
+    expect(resolveWorktreeCardAttentionTone('working', true)).toBeNull()
+  })
+
+  it('leaves quiet, read cards untinted', () => {
+    expect(resolveWorktreeCardAttentionTone('active', false)).toBeNull()
+    expect(resolveWorktreeCardAttentionTone('working', false)).toBeNull()
+    expect(resolveWorktreeCardAttentionTone('done', false)).toBeNull()
+  })
+})

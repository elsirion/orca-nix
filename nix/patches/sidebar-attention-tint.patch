+import type { WorktreeStatus } from '@/lib/worktree-status'
+
+export type WorktreeCardAttentionTone = 'question' | 'unread'
+
+/**
+ * Which whole-card tint a worktree card earns. `question` is the live "agent is
+ * asking you something" state; `unread` is a prior-turn completion/bell the user
+ * has not looked at yet. Mirrors the status-lane rule: a live working/permission
+ * state is newer than the unread flag, so it owns the card until the turn ends.
+ */
+export function resolveWorktreeCardAttentionTone(
+  status: WorktreeStatus,
+  isUnread: boolean
+): WorktreeCardAttentionTone | null {
+  if (status === 'permission') {
+    return 'question'
+  }
+  if (isUnread && status !== 'working') {
+    return 'unread'
+  }
+  return null
+}
+
+// Why: same hues as the glyphs they enlarge — the tab strip's amber wash for
+// unread, the shared --agent-question token for permission — so the card and its
+// status icon never disagree. A child overlay (not a card background) layers
+// cleanly over the active/selected data-attribute styles.
+const ATTENTION_OVERLAY_BASE_CLASS_NAME = 'pointer-events-none absolute inset-0 rounded-lg'
+
+export const WORKTREE_CARD_ATTENTION_OVERLAY_CLASS_NAMES: Record<
+  WorktreeCardAttentionTone,
+  string
+> = {
+  question: `${ATTENTION_OVERLAY_BASE_CLASS_NAME} bg-agent-question/[0.08] ring-1 ring-inset ring-agent-question/30`,
+  unread: `${ATTENTION_OVERLAY_BASE_CLASS_NAME} bg-amber-500/10`
+}

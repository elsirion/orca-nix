+import { describe, expect, it } from 'vitest'
+import { hasExplicitTuiLaunchCustomization } from './tui-agent-launch-customization'
+
+describe('hasExplicitTuiLaunchCustomization', () => {
+  it('is false without any customization', () => {
+    expect(hasExplicitTuiLaunchCustomization({}, 'claude')).toBe(false)
+    expect(hasExplicitTuiLaunchCustomization({ linuxAgentSandboxEnabled: false }, 'claude')).toBe(
+      false
+    )
+  })
+
+  it('forces the terminal route when the Linux agent sandbox is on', () => {
+    expect(hasExplicitTuiLaunchCustomization({ linuxAgentSandboxEnabled: true }, 'claude')).toBe(
+      true
+    )
+  })
+
+  it('still detects a command override', () => {
+    expect(
+      hasExplicitTuiLaunchCustomization({ agentCmdOverrides: { claude: 'my-claude' } }, 'claude')
+    ).toBe(true)
+  })
+})

+import { chmodSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import {
+  BWRAP_MISSING_MESSAGE,
+  findExecutableInPathSegments,
+  resolveBubblewrapExecutable,
+  USERNS_UNAVAILABLE_MESSAGE
+} from './bubblewrap-preflight'
+
+let root: string
+
+beforeEach(() => {
+  root = mkdtempSync(join(tmpdir(), 'orca-bwrap-preflight-'))
+})
+
+afterEach(() => {
+  rmSync(root, { recursive: true, force: true })
+})
+
+function installFakeBwrap(dir: string): string {
+  mkdirSync(dir, { recursive: true })
+  const path = join(dir, 'bwrap')
+  writeFileSync(path, '#!/bin/sh\nexit 0\n')
+  chmodSync(path, 0o755)
+  return path
+}
+
+describe('findExecutableInPathSegments', () => {
+  it('returns the first executable regular file on the segments', () => {
+    const first = installFakeBwrap(join(root, 'a'))
+    installFakeBwrap(join(root, 'b'))
+    mkdirSync(join(root, 'dir-only', 'bwrap'), { recursive: true })
+    expect(
+      findExecutableInPathSegments('bwrap', [join(root, 'dir-only'), join(root, 'a'), join(root, 'b')])
+    ).toBe(first)
+  })
+
+  it('ignores non-executable files and empty segments', () => {
+    mkdirSync(join(root, 'c'))
+    writeFileSync(join(root, 'c', 'bwrap'), '')
+    chmodSync(join(root, 'c', 'bwrap'), 0o644)
+    expect(findExecutableInPathSegments('bwrap', ['', join(root, 'c')])).toBeNull()
+  })
+})
+
+describe('resolveBubblewrapExecutable', () => {
+  it('returns the bwrap path when found and user namespaces work', async () => {
+    const path = installFakeBwrap(join(root, 'bin'))
+    await expect(
+      resolveBubblewrapExecutable({
+        pathSegments: async () => [join(root, 'bin')],
+        probe: () => true
+      })
+    ).resolves.toBe(path)
+  })
+
+  it('throws a clear error when bwrap is missing', async () => {
+    await expect(
+      resolveBubblewrapExecutable({ pathSegments: async () => [root], probe: () => true })
+    ).rejects.toThrow(BWRAP_MISSING_MESSAGE)
+  })
+
+  it('throws a clear error when user namespaces are unavailable', async () => {
+    installFakeBwrap(join(root, 'bin'))
+    await expect(
+      resolveBubblewrapExecutable({
+        pathSegments: async () => [join(root, 'bin')],
+        probe: () => false
+      })
+    ).rejects.toThrow(USERNS_UNAVAILABLE_MESSAGE)
+  })
+})
diff --git a/src/main/agent-sandbox/bubblewrap-preflight.ts b/src/main/agent-sandbox/bubblewrap-preflight.ts
new file mode 100644
index 0000000000..8522a143ad
--- /dev/null
+++ b/src/main/agent-sandbox/bubblewrap-preflight.ts
@@ -0,0 +1,73 @@
+import { accessSync, constants, statSync } from 'node:fs'
+import { delimiter, join } from 'node:path'
+import { runProcessSync } from '../../shared/child-process/run-process'
+import { hydrateShellPath } from '../startup/hydrate-shell-path'
+
+export const BWRAP_MISSING_MESSAGE =
+  'Agent sandbox is enabled but bubblewrap (bwrap) is not installed.'
+export const USERNS_UNAVAILABLE_MESSAGE =
+  'Agent sandbox is enabled but unprivileged user namespaces are not available on this host.'
+
+const USER_NAMESPACE_PROBE_TIMEOUT_MS = 3000
+
+export function findExecutableInPathSegments(
+  name: string,
+  segments: readonly string[]
+): string | null {
+  for (const segment of segments) {
+    if (!segment) {
+      continue
+    }
+    const candidate = join(segment, name)
+    try {
+      if (!statSync(candidate).isFile()) {
+        continue
+      }
+      accessSync(candidate, constants.X_OK)
+      return candidate
+    } catch {
+      continue
+    }
+  }
+  return null
+}
+
+/** Same probe the extracted-AppImage launcher uses to detect a usable userns. */
+export function probeUserNamespaces(run: typeof runProcessSync = runProcessSync): boolean {
+  try {
+    return (
+      run({
+        program: 'unshare',
+        args: ['-Ur', 'true'],
+        stdio: 'ignore',
+        timeoutMs: USER_NAMESPACE_PROBE_TIMEOUT_MS
+      }).code === 0
+    )
+  } catch {
+    return false
+  }
+}
+
+/** Why: the main process PATH is often narrower than the user's shell PATH, so probe the shell's first. */
+async function defaultPathSegments(): Promise<readonly string[]> {
+  const hydrated = await hydrateShellPath()
+  const processSegments = (process.env.PATH ?? '').split(delimiter)
+  return hydrated.ok ? [...hydrated.segments, ...processSegments] : processSegments
+}
+
+export async function resolveBubblewrapExecutable(
+  deps: {
+    pathSegments?: () => Promise<readonly string[]>
+    probe?: () => boolean
+  } = {}
+): Promise<string> {
+  const segments = await (deps.pathSegments ?? defaultPathSegments)()
+  const bwrapPath = findExecutableInPathSegments('bwrap', segments)
+  if (!bwrapPath) {
+    throw new Error(BWRAP_MISSING_MESSAGE)
+  }
+  if (!(deps.probe ?? probeUserNamespaces)()) {
+    throw new Error(USERNS_UNAVAILABLE_MESSAGE)
+  }
+  return bwrapPath
+}

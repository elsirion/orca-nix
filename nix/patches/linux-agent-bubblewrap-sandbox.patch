+import { existsSync, mkdirSync, mkdtempSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { delimiter, join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { runProcessSync } from '../../shared/child-process/run-process'
+import { BUBBLEWRAP_SYSTEM_MOUNT_CANDIDATES, buildBubblewrapArgs } from './bubblewrap-args'
+import { findExecutableInPathSegments, probeUserNamespaces } from './bubblewrap-preflight'
+import { stageCowMounts } from './agent-sandbox-launch'
+import { readWorkspacerSandboxConfig } from './workspacer-config'
+
+const bwrapPath =
+  process.platform === 'linux'
+    ? findExecutableInPathSegments('bwrap', (process.env.PATH ?? '').split(delimiter))
+    : null
+const canRun = bwrapPath !== null && probeUserNamespaces()
+
+describe.skipIf(!canRun)('bubblewrap sandbox (real bwrap)', () => {
+  it('runs a command with a private home, workspacer mounts and env, and a writable workdir', () => {
+    const root = mkdtempSync(join(process.env.TMPDIR || '/tmp', 'orca-bwrap-it-'))
+    try {
+      const workdir = join(root, 'work')
+      const configDir = join(root, 'cfg')
+      const mounted = join(root, 'mounted-dir')
+      mkdirSync(workdir)
+      mkdirSync(join(configDir, 'home_rw'), { recursive: true })
+      mkdirSync(join(configDir, 'home_cow'), { recursive: true })
+      mkdirSync(mounted)
+      writeFileSync(join(mounted, 'marker'), 'mounted')
+      writeFileSync(join(configDir, 'env'), 'ORCA_IT_ENV=from-env\n')
+      symlinkSync(mounted, join(configDir, 'home_rw', '.orca-it-linked'))
+      writeFileSync(join(configDir, 'home_cow', '.orca-it-cow'), 'original')
+
+      const homeDir = homedir()
+      const config = readWorkspacerSandboxConfig(configDir)
+      const { mounts, stagingDir } = stageCowMounts(config.homeMounts, join(root, 'staging'), homeDir)
+      const args = buildBubblewrapArgs({
+        homeDir,
+        workdir,
+        gitCommonDir: null,
+        systemMounts: BUBBLEWRAP_SYSTEM_MOUNT_CANDIDATES.filter((path) => existsSync(path)),
+        tmpSizeMb: 16,
+        homeSizeMb: 16,
+        orcaMounts: [],
+        userHomeMounts: mounts,
+        userEnv: config.env
+      })
+      const script = [
+        'echo "home=$HOME"',
+        'echo "env=$ORCA_IT_ENV"',
+        'echo "sandbox=$ORCA_AGENT_SANDBOX"',
+        'echo "linked=$(cat "$HOME/.orca-it-linked/marker")"',
+        'echo "cow=$(cat "$HOME/.orca-it-cow")"',
+        'echo "writable=$(test -w "$PWD" && echo yes)"',
+        'echo "home-entries=$(ls -A "$HOME" | wc -l)"',
+        'echo "changed" > "$HOME/.orca-it-cow"'
+      ].join('; ')
+      const result = runProcessSync({
+        program: bwrapPath!,
+        args: [...args, '--', '/bin/sh', '-c', script],
+        timeoutMs: 20_000
+      })
+      expect(result.stderr).toBe('')
+      expect(result.code).toBe(0)
+      expect(result.stdout.trim().split('\n')).toEqual([
+        `home=${homeDir}`,
+        'env=from-env',
+        'sandbox=bwrap',
+        'linked=mounted',
+        'cow=original',
+        'writable=yes',
+        'home-entries=2'
+      ])
+      // Why: cow writes land in the staging copy, never in the config source.
+      expect(existsSync(join(configDir, 'home_cow', '.orca-it-cow'))).toBe(true)
+      expect(stagingDir).not.toBeNull()
+    } finally {
+      rmSync(root, { recursive: true, force: true })
+    }
+  })
+})

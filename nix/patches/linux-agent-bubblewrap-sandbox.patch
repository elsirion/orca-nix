new file mode 100644
index 0000000000..e34b101677
--- /dev/null
+++ b/src/main/ipc/pty/agent-sandbox-spawn-step.ts
@@ -0,0 +1,90 @@
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import { getAppEnvironment } from '../../../shared/app-environment'
+import type { GlobalSettings } from '../../../shared/global-settings-types'
+import { isTuiAgent } from '../../../shared/tui-agent-config'
+import { prepareAgentSandboxStartupCommand } from '../../agent-sandbox/agent-sandbox-launch'
+
+/**
+ * The slice of spawn state the sandbox step reads. Both PTY pipelines (the renderer's IPC
+ * handler and the runtime controller used by `orca serve`, mobile and the CLI) satisfy it.
+ */
+export type AgentSandboxSpawnContext = {
+  deps: { getSettings?: () => Pick<GlobalSettings, 'linuxAgentSandboxEnabled'> | undefined }
+  args: { connectionId?: string | null; launchAgent?: unknown }
+  cwd: string | undefined
+  env: Record<string, string> | undefined
+  expectedWslDistro: string | null
+  spawnOptions: { command?: string }
+}
+
+export type AgentSandboxSpawnGate = {
+  platform: NodeJS.Platform
+  settings: Pick<GlobalSettings, 'linuxAgentSandboxEnabled'> | undefined
+  connectionId: string | null | undefined
+  launchAgent: unknown
+  command: string | undefined
+  wslDistro: string | null
+  cwd: string | undefined
+}
+
+/** Local Linux agent launches only: SSH panes execute elsewhere and WSL has its own runtime. */
+export function shouldSandboxRuntimePtySpawn(input: AgentSandboxSpawnGate): boolean {
+  return (
+    input.settings?.linuxAgentSandboxEnabled === true &&
+    input.platform === 'linux' &&
+    !input.connectionId &&
+    input.wslDistro === null &&
+    isTuiAgent(input.launchAgent) &&
+    typeof input.command === 'string' &&
+    input.command.trim().length > 0 &&
+    typeof input.cwd === 'string' &&
+    input.cwd.length > 0
+  )
+}
+
+/**
+ * Rewrites the PTY startup command to run inside bubblewrap. The pipeline's `launchCommand` stays
+ * the plain agent command so spawn records and Claude-launch detection keep seeing the agent.
+ */
+export async function applyAgentSandboxToPtySpawn(
+  ctx: AgentSandboxSpawnContext,
+  deps: {
+    prepare?: typeof prepareAgentSandboxStartupCommand
+    platform?: NodeJS.Platform
+    stagingParent?: () => string
+  } = {}
+): Promise<void> {
+  const command = ctx.spawnOptions.command
+  const cwd = ctx.cwd
+  if (
+    !shouldSandboxRuntimePtySpawn({
+      platform: deps.platform ?? process.platform,
+      settings: ctx.deps.getSettings?.(),
+      connectionId: ctx.args.connectionId,
+      launchAgent: ctx.args.launchAgent,
+      command,
+      wslDistro: ctx.expectedWslDistro,
+      cwd
+    }) ||
+    !isTuiAgent(ctx.args.launchAgent) ||
+    command === undefined ||
+    cwd === undefined
+  ) {
+    return
+  }
+  ctx.spawnOptions.command = await (deps.prepare ?? prepareAgentSandboxStartupCommand)({
+    agent: ctx.args.launchAgent,
+    command,
+    workdir: cwd,
+    // Why: a non-daemon spawn carries only the caller overlay, so the managed config dir may sit in process.env.
+    env: { ...process.env, ...ctx.env },
+    homeDir: homedir(),
+    processEnv: process.env,
+    stagingParent: (deps.stagingParent ?? defaultStagingParent)()
+  })
+}
+
+function defaultStagingParent(): string {
+  return join(getAppEnvironment().getPath('temp'), 'orca-agent-sandbox')
+}

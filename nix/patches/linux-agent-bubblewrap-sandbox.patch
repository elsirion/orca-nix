diff --git a/src/main/agent-sandbox/bubblewrap-args.ts b/src/main/agent-sandbox/bubblewrap-args.ts
new file mode 100644
index 0000000000..cc3819a13b
--- /dev/null
+++ b/src/main/agent-sandbox/bubblewrap-args.ts
@@ -0,0 +1,95 @@
+import { dirname } from 'node:path'
+import type { WorkspacerEnvEntry } from './workspacer-config'
+
+/**
+ * Pure bubblewrap argv builder; a port of workspacer's `_ws_run_sandboxed`. Everything that
+ * touches the filesystem (existence checks, cow staging, git resolution) happens in the caller
+ * so this stays deterministic and unit-testable.
+ */
+
+/** Bound read-only when present. Whole `/etc` instead of workspacer's file list: bwrap runs as the user, so a bind cannot expose anything they could not already read. */
+export const BUBBLEWRAP_SYSTEM_MOUNT_CANDIDATES: readonly string[] = [
+  '/nix',
+  '/nix/var/nix/daemon-socket',
+  '/run/current-system',
+  '/usr',
+  '/bin',
+  '/sbin',
+  '/lib',
+  '/lib32',
+  '/lib64',
+  '/opt',
+  '/etc',
+  '/run/systemd/resolve'
+]
+
+export const DEFAULT_SANDBOX_TMP_SIZE_MB = 8192
+export const DEFAULT_SANDBOX_HOME_SIZE_MB = 2048
+
+export type SandboxBindMount = { mode: 'ro' | 'rw'; source: string; target: string }
+
+export type BubblewrapArgsInput = {
+  homeDir: string
+  workdir: string
+  gitCommonDir: string | null
+  /** Existing subset of `BUBBLEWRAP_SYSTEM_MOUNT_CANDIDATES`. */
+  systemMounts: readonly string[]
+  tmpSizeMb: number
+  homeSizeMb: number
+  /** What Orca's own integration needs (hooks, agent config dirs); user mounts can override. */
+  orcaMounts: readonly SandboxBindMount[]
+  /** workspacer `home_*` entries, cow entries already staged and passed as rw. */
+  userHomeMounts: readonly SandboxBindMount[]
+  userEnv: readonly WorkspacerEnvEntry[]
+}
+
+export function resolveSandboxSizeMb(raw: string | undefined, fallback: number): number {
+  const parsed = Number.parseInt(raw?.trim() ?? '', 10)
+  return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback
+}
+
+export function buildBubblewrapArgs(input: BubblewrapArgsInput): string[] {
+  const args: string[] = ['--unshare-all', '--share-net', '--die-with-parent']
+  args.push('--dev', '/dev', '--proc', '/proc', '--ro-bind', '/sys', '/sys')
+  for (const path of input.systemMounts) {
+    args.push('--ro-bind', path, path)
+  }
+  // Why: RAM-backed and only freed on exit; capped so a runaway write fails loudly instead of eating the machine.
+  args.push('--size', String(input.tmpSizeMb * 1024 * 1024), '--tmpfs', '/tmp')
+  args.push('--size', String(input.homeSizeMb * 1024 * 1024), '--tmpfs', input.homeDir)
+  args.push('--bind', input.workdir, input.workdir)
+  if (input.gitCommonDir) {
+    args.push('--bind', input.gitCommonDir, input.gitCommonDir)
+  }
+  args.push('--chdir', input.workdir)
+  args.push('--setenv', 'HOME', input.homeDir)
+  // Why: lets `ws` refuse nested workspace creation, which would land on the discarded tmpfs home.
+  args.push('--setenv', 'WORKSPACER_SANDBOX', '1')
+  args.push('--setenv', 'ORCA_AGENT_SANDBOX', 'bwrap')
+
+  const createdDirs = new Set<string>([input.homeDir])
+  for (const mount of [...input.orcaMounts, ...input.userHomeMounts]) {
+    for (const dir of parentDirsUnderHome(mount.target, input.homeDir)) {
+      if (!createdDirs.has(dir)) {
+        createdDirs.add(dir)
+        args.push('--dir', dir)
+      }
+    }
+    args.push(mount.mode === 'ro' ? '--ro-bind' : '--bind', mount.source, mount.target)
+  }
+  for (const entry of input.userEnv) {
+    args.push('--setenv', entry.key, entry.value)
+  }
+  return args
+}
+
+/** Ancestors of `target` strictly below `homeDir`, outermost first; empty when outside home. */
+function parentDirsUnderHome(target: string, homeDir: string): string[] {
+  const dirs: string[] = []
+  let parent = dirname(target)
+  while (parent !== homeDir && parent !== dirname(parent)) {
+    dirs.unshift(parent)
+    parent = dirname(parent)
+  }
+  return parent === homeDir ? dirs : []
+}

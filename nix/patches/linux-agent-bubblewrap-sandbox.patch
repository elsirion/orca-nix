+import { describe, expect, it, vi } from 'vitest'
+import {
+  applyAgentSandboxToPtySpawn,
+  shouldSandboxRuntimePtySpawn,
+  type AgentSandboxSpawnContext,
+  type AgentSandboxSpawnGate
+} from './agent-sandbox-spawn-step'
+import type { PtyIpcSpawnState } from './ipc/spawn-state'
+import type { RuntimePtySpawnState } from './runtime/spawn-state'
+
+function gate(overrides: Partial<AgentSandboxSpawnGate> = {}): AgentSandboxSpawnGate {
+  return {
+    platform: 'linux',
+    settings: { linuxAgentSandboxEnabled: true },
+    connectionId: undefined,
+    launchAgent: 'claude',
+    command: 'claude --dangerously-skip-permissions',
+    wslDistro: null,
+    cwd: '/home/u/ws/repo/feature',
+    ...overrides
+  }
+}
+
+describe('shouldSandboxRuntimePtySpawn', () => {
+  it('is true for a local Linux agent launch with the setting on', () => {
+    expect(shouldSandboxRuntimePtySpawn(gate())).toBe(true)
+  })
+
+  it.each<[string, Partial<AgentSandboxSpawnGate>]>([
+    ['setting off', { settings: { linuxAgentSandboxEnabled: false } }],
+    ['no settings', { settings: undefined }],
+    ['macOS', { platform: 'darwin' }],
+    ['SSH pane', { connectionId: 'ssh:box' }],
+    ['WSL distro', { wslDistro: 'Ubuntu' }],
+    ['plain terminal', { launchAgent: undefined }],
+    ['unknown agent', { launchAgent: 'not-an-agent' }],
+    ['empty command', { command: '   ' }],
+    ['no cwd', { cwd: undefined }]
+  ])('is false for %s', (_label, overrides) => {
+    expect(shouldSandboxRuntimePtySpawn(gate(overrides))).toBe(false)
+  })
+})
+
+describe('applyAgentSandboxToPtySpawn', () => {
+  // Why: compile-time proof that both real pipeline states satisfy the shared context type.
+  const acceptsRuntimeState = (ctx: RuntimePtySpawnState): AgentSandboxSpawnContext => ctx
+  const acceptsIpcState = (ctx: PtyIpcSpawnState): AgentSandboxSpawnContext => ctx
+  void acceptsRuntimeState
+  void acceptsIpcState
+
+  function makeCtx(overrides: Partial<AgentSandboxSpawnContext> = {}): AgentSandboxSpawnContext {
+    return {
+      deps: { getSettings: () => ({ linuxAgentSandboxEnabled: true }) },
+      args: { launchAgent: 'claude', connectionId: undefined },
+      cwd: '/home/u/ws/repo/feature',
+      env: { CLAUDE_CONFIG_DIR: '/data/claude-home' },
+      expectedWslDistro: null,
+      spawnOptions: { command: 'claude --dangerously-skip-permissions' },
+      ...overrides
+    }
+  }
+
+  it('replaces the spawn command', async () => {
+    const ctx = makeCtx()
+    const prepare = vi.fn(async () => 'bwrap … -- /bin/sh -c claude')
+    await applyAgentSandboxToPtySpawn(ctx, {
+      prepare,
+      platform: 'linux',
+      stagingParent: () => '/tmp/staging'
+    })
+    expect(prepare).toHaveBeenCalledWith(
+      expect.objectContaining({
+        agent: 'claude',
+        command: 'claude --dangerously-skip-permissions',
+        workdir: '/home/u/ws/repo/feature',
+        env: expect.objectContaining({ CLAUDE_CONFIG_DIR: '/data/claude-home' }),
+        stagingParent: '/tmp/staging'
+      })
+    )
+    expect(ctx.spawnOptions.command).toBe('bwrap … -- /bin/sh -c claude')
+  })
+
+  it('does nothing when gated off', async () => {
+    const ctx = makeCtx()
+    const prepare = vi.fn(async () => 'never')
+    await applyAgentSandboxToPtySpawn(ctx, { prepare, platform: 'darwin' })
+    expect(prepare).not.toHaveBeenCalled()
+    expect(ctx.spawnOptions.command).toBe('claude --dangerously-skip-permissions')
+  })
+
+  it('propagates preflight failures so the launch never runs unsandboxed', async () => {
+    const ctx = makeCtx()
+    await expect(
+      applyAgentSandboxToPtySpawn(ctx, {
+        prepare: async () => {
+          throw new Error('Agent sandbox is enabled but bubblewrap (bwrap) is not installed.')
+        },
+        platform: 'linux',
+        stagingParent: () => '/tmp/staging'
+      })
+    ).rejects.toThrow('bubblewrap (bwrap) is not installed')
+    expect(ctx.spawnOptions.command).toBe('claude --dangerously-skip-permissions')
+  })
+})

+import { mkdirSync, mkdtempSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import {
+  listWorkspacerHomeMounts,
+  parseWorkspacerEnvFile,
+  readWorkspacerSandboxConfig,
+  resolveWorkspacerConfigDir
+} from './workspacer-config'
+
+describe('resolveWorkspacerConfigDir', () => {
+  it('prefers WORKSPACER_CONFIG_DIR', () => {
+    expect(resolveWorkspacerConfigDir({ WORKSPACER_CONFIG_DIR: '/cfg/ws' }, '/home/u')).toBe(
+      '/cfg/ws'
+    )
+  })
+
+  it('falls back to XDG_CONFIG_HOME/workspacer', () => {
+    expect(resolveWorkspacerConfigDir({ XDG_CONFIG_HOME: '/xdg' }, '/home/u')).toBe(
+      '/xdg/workspacer'
+    )
+  })
+
+  it('defaults to ~/.config/workspacer', () => {
+    expect(resolveWorkspacerConfigDir({}, '/home/u')).toBe('/home/u/.config/workspacer')
+  })
+})
+
+describe('parseWorkspacerEnvFile', () => {
+  it('parses KEY=VALUE lines and strips comments, export and symmetric quotes', () => {
+    const text = [
+      '# comment',
+      '',
+      'PLAIN=value',
+      '  SPACED =  padded  ',
+      'export EXPORTED=1',
+      'DQ="double quoted"',
+      "SQ='single quoted'",
+      'MIXED="keep\'',
+      'not a valid line',
+      '1BAD=x'
+    ].join('\n')
+    expect(parseWorkspacerEnvFile(text)).toEqual([
+      { key: 'PLAIN', value: 'value' },
+      { key: 'SPACED', value: 'padded' },
+      { key: 'EXPORTED', value: '1' },
+      { key: 'DQ', value: 'double quoted' },
+      { key: 'SQ', value: 'single quoted' },
+      { key: 'MIXED', value: '"keep\'' }
+    ])
+  })
+})
+
+describe('listWorkspacerHomeMounts', () => {
+  let root: string
+
+  beforeEach(() => {
+    root = mkdtempSync(join(tmpdir(), 'orca-workspacer-config-'))
+  })
+
+  afterEach(() => {
+    rmSync(root, { recursive: true, force: true })
+  })
+
+  it('returns nothing for a missing tree', () => {
+    expect(listWorkspacerHomeMounts(join(root, 'home_ro'), 'ro')).toEqual([])
+  })
+
+  it('treats files, symlinks and empty dirs as leaves and recurses into real dirs', () => {
+    const tree = join(root, 'home_rw')
+    const real = join(root, 'real-target')
+    mkdirSync(join(tree, '.local', 'share'), { recursive: true })
+    mkdirSync(join(tree, 'empty-dir'))
+    mkdirSync(real)
+    writeFileSync(join(tree, '.gitconfig'), '')
+    symlinkSync(real, join(tree, '.local', 'share', 'linked'))
+    symlinkSync(join(root, 'does-not-exist'), join(tree, '.broken'))
+
+    expect(listWorkspacerHomeMounts(tree, 'rw')).toEqual([
+      { mode: 'rw', source: join(tree, '.gitconfig'), homeRelativePath: '.gitconfig' },
+      {
+        mode: 'rw',
+        source: join(tree, '.local', 'share', 'linked'),
+        homeRelativePath: join('.local', 'share', 'linked')
+      },
+      { mode: 'rw', source: join(tree, 'empty-dir'), homeRelativePath: 'empty-dir' }
+    ])
+  })
+})
+
+describe('readWorkspacerSandboxConfig', () => {
+  let configDir: string
+
+  beforeEach(() => {
+    configDir = mkdtempSync(join(tmpdir(), 'orca-workspacer-config-'))
+  })
+
+  afterEach(() => {
+    rmSync(configDir, { recursive: true, force: true })
+  })
+
+  it('reads env and ro/rw/cow trees in order', () => {

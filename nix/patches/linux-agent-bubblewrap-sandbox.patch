index 0000000000..dc21cbf616
--- /dev/null
+++ b/src/main/agent-sandbox/workspacer-config.ts
@@ -0,0 +1,125 @@
+import { existsSync, lstatSync, readdirSync, readFileSync } from 'node:fs'
+import { join, relative } from 'node:path'
+
+/**
+ * Reader for workspacer's sandbox config directory (base config only, no profiles).
+ * Layout and semantics mirror `ws.sh` in https://github.com/elsirion/workspacer so an
+ * existing `~/.config/workspacer` works unchanged.
+ */
+
+export type WorkspacerHomeMountMode = 'ro' | 'rw' | 'cow'
+
+export type WorkspacerHomeMount = {
+  mode: WorkspacerHomeMountMode
+  /** Host path bound into the sandbox; a symlink is bound as-is (bwrap follows it). */
+  source: string
+  /** Path relative to `$HOME` inside the sandbox. */
+  homeRelativePath: string
+}
+
+export type WorkspacerEnvEntry = { key: string; value: string }
+
+export type WorkspacerSandboxConfig = {
+  configDir: string
+  env: WorkspacerEnvEntry[]
+  homeMounts: WorkspacerHomeMount[]
+}
+
+const HOME_MOUNT_TREES: readonly { dir: string; mode: WorkspacerHomeMountMode }[] = [
+  { dir: 'home_ro', mode: 'ro' },
+  { dir: 'home_rw', mode: 'rw' },
+  { dir: 'home_cow', mode: 'cow' }
+]
+
+const ENV_LINE = /^([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$/
+
+export function resolveWorkspacerConfigDir(env: NodeJS.ProcessEnv, homeDir: string): string {
+  const explicit = env.WORKSPACER_CONFIG_DIR?.trim()
+  if (explicit) {
+    return explicit
+  }
+  const xdgConfigHome = env.XDG_CONFIG_HOME?.trim() || join(homeDir, '.config')
+  return join(xdgConfigHome, 'workspacer')
+}
+
+export function parseWorkspacerEnvFile(text: string): WorkspacerEnvEntry[] {
+  const entries: WorkspacerEnvEntry[] = []
+  for (const rawLine of text.split(/\r?\n/)) {
+    let line = rawLine.trim()
+    if (!line || line.startsWith('#')) {
+      continue
+    }
+    if (/^export\s/.test(line)) {
+      line = line.replace(/^export\s+/, '')
+    }
+    const match = ENV_LINE.exec(line)
+    if (!match) {
+      continue
+    }
+    const value = match[2].trimStart()
+    entries.push({ key: match[1], value: stripSymmetricQuotes(value) })
+  }
+  return entries
+}
+
+function stripSymmetricQuotes(value: string): string {
+  if (value.length >= 2) {
+    const first = value.at(0)
+    const last = value.at(-1)
+    if ((first === '"' || first === "'") && first === last) {
+      return value.slice(1, -1)
+    }
+  }
+  return value
+}
+
+/**
+ * Walks a `home_*` tree. A real directory with children is a container (its children are the
+ * mount points); files, symlinks and empty directories are leaves bound at the same relative
+ * path under `$HOME`.
+ */
+export function listWorkspacerHomeMounts(
+  treeRoot: string,
+  mode: WorkspacerHomeMountMode
+): WorkspacerHomeMount[] {
+  if (!isRealDirectory(treeRoot)) {
+    return []
+  }
+  const mounts: WorkspacerHomeMount[] = []
+  const visit = (dir: string): void => {
+    const entries = readdirSync(dir, { withFileTypes: true }).sort((a, b) =>
+      a.name.localeCompare(b.name)
+    )
+    for (const entry of entries) {
+      const entryPath = join(dir, entry.name)
+      if (entry.isDirectory() && readdirSync(entryPath).length > 0) {
+        visit(entryPath)
+        continue
+      }
+      // Why: existsSync follows symlinks, so a dangling link is dropped instead of aborting the launch.
+      if (!existsSync(entryPath)) {
+        continue
+      }
+      mounts.push({ mode, source: entryPath, homeRelativePath: relative(treeRoot, entryPath) })
+    }
+  }
+  visit(treeRoot)
+  return mounts
+}
+
+export function readWorkspacerSandboxConfig(configDir: string): WorkspacerSandboxConfig {
+  const envPath = join(configDir, 'env')
+  const env = existsSync(envPath) ? parseWorkspacerEnvFile(readFileSync(envPath, 'utf8')) : []
+  const homeMounts = HOME_MOUNT_TREES.flatMap(({ dir, mode }) =>
+    listWorkspacerHomeMounts(join(configDir, dir), mode)
+  )
+  return { configDir, env, homeMounts }
+}
+
+function isRealDirectory(path: string): boolean {
+  try {
+    return lstatSync(path).isDirectory()
+  } catch {
+    return false
+  }
+}

+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { quoteStartupArg } from '../../shared/tui-agent-startup-shell'
+import {
+  prepareAgentSandboxStartupCommand,
+  resolveOrcaSandboxMounts,
+  resolveSandboxGitCommonDir,
+  stageCowMounts,
+  wrapStartupCommandInBubblewrap
+} from './agent-sandbox-launch'
+
+const HOME = '/home/u'
+const q = (value: string): string => quoteStartupArg(value, 'posix')
+const argvLine = (...argv: string[]): string => argv.map(q).join(' ')
+
+describe('resolveOrcaSandboxMounts', () => {
+  it('binds the hook dir and the effective Claude config dir for claude', () => {
+    const mounts = resolveOrcaSandboxMounts({
+      agent: 'claude',
+      homeDir: HOME,
+      env: { CLAUDE_CONFIG_DIR: '/data/claude-home' },
+      exists: () => true
+    })
+    expect(mounts).toEqual([
+      { mode: 'ro', source: '/home/u/.orca/agent-hooks', target: '/home/u/.orca/agent-hooks' },
+      { mode: 'rw', source: '/data/claude-home', target: '/data/claude-home' },
+      { mode: 'rw', source: '/home/u/.claude.json', target: '/home/u/.claude.json' }
+    ])
+  })
+
+  it('falls back to ~/.claude and drops missing paths', () => {
+    const mounts = resolveOrcaSandboxMounts({
+      agent: 'claude-agent-teams',
+      homeDir: HOME,
+      env: {},
+      exists: (path) => path === '/home/u/.claude'
+    })
+    expect(mounts).toEqual([
+      { mode: 'rw', source: '/home/u/.claude', target: '/home/u/.claude' }
+    ])
+  })
+
+  it('binds CODEX_HOME for codex and nothing agent-specific for others', () => {
+    expect(
+      resolveOrcaSandboxMounts({ agent: 'codex', homeDir: HOME, env: { CODEX_HOME: '/c' }, exists: () => true })
+    ).toEqual([
+      { mode: 'ro', source: '/home/u/.orca/agent-hooks', target: '/home/u/.orca/agent-hooks' },
+      { mode: 'rw', source: '/c', target: '/c' }
+    ])
+    expect(
+      resolveOrcaSandboxMounts({ agent: 'gemini', homeDir: HOME, env: {}, exists: () => true })
+    ).toEqual([
+      { mode: 'ro', source: '/home/u/.orca/agent-hooks', target: '/home/u/.orca/agent-hooks' }
+    ])
+  })
+})
+
+describe('resolveSandboxGitCommonDir', () => {
+  it('returns null when .git is not a file (main repo or folder workspace)', () => {
+    expect(resolveSandboxGitCommonDir('/w', { isFile: () => false })).toBeNull()
+  })
+
+  it('resolves the common dir relative to the worktree', () => {
+    expect(
+      resolveSandboxGitCommonDir('/w/feature', {
+        isFile: () => true,
+        isDirectory: (path) => path === '/w/.git',
+        gitCommonDir: () => '../.git\n'
+      })
+    ).toBe('/w/.git')
+  })
+
+  it('throws when git fails or the common dir is missing', () => {
+    expect(() =>
+      resolveSandboxGitCommonDir('/w/feature', {
+        isFile: () => true,
+        gitCommonDir: () => {
+          throw new Error('boom')
+        }
+      })
+    ).toThrow("'/w/feature' is a git worktree but its backing repository is unavailable")
+    expect(() =>
+      resolveSandboxGitCommonDir('/w/feature', {
+        isFile: () => true,
+        isDirectory: () => false,
+        gitCommonDir: () => '/gone/.git'
+      })
+    ).toThrow('backing repository is unavailable')
+  })
+})
+
+describe('stageCowMounts', () => {
+  let root: string
+
+  beforeEach(() => {
+    root = mkdtempSync(join(tmpdir(), 'orca-sandbox-cow-'))
+  })
+
+  afterEach(() => {
+    rmSync(root, { recursive: true, force: true })
+  })
+
+  it('passes ro/rw through and copies cow entries into a staging dir', () => {
+    const cowSource = join(root, 'home_cow', '.config', 'tool')
+    mkdirSync(cowSource, { recursive: true })
+    writeFileSync(join(cowSource, 'settings.json'), '{"a":1}')
+    const { mounts, stagingDir } = stageCowMounts(
+      [
+        { mode: 'ro', source: '/cfg/home_ro/.bashrc', homeRelativePath: '.bashrc' },
+        { mode: 'cow', source: cowSource, homeRelativePath: join('.config', 'tool') }
+      ],
+      join(root, 'staging'),
+      HOME
+    )
+    expect(stagingDir).not.toBeNull()
+    expect(mounts).toEqual([
+      { mode: 'ro', source: '/cfg/home_ro/.bashrc', target: '/home/u/.bashrc' },
+      { mode: 'rw', source: join(stagingDir!, '.config', 'tool'), target: '/home/u/.config/tool' }
+    ])
+    expect(readFileSync(join(stagingDir!, '.config', 'tool', 'settings.json'), 'utf8')).toBe('{"a":1}')
+  })
+
+  it('creates no staging dir without cow entries', () => {
+    const result = stageCowMounts(
+      [{ mode: 'rw', source: '/cfg/home_rw/.claude', homeRelativePath: '.claude' }],
+      join(root, 'staging'),
+      HOME
+    )
+    expect(result.stagingDir).toBeNull()
+    expect(existsSync(join(root, 'staging'))).toBe(false)
+  })
+})
+
+describe('wrapStartupCommandInBubblewrap', () => {
+  it('runs the original command through /bin/sh -c inside bwrap', () => {
+    const command = "claude --dangerously-skip-permissions --prefill 'fix it'"
+    expect(
+      wrapStartupCommandInBubblewrap({
+        bwrapPath: '/usr/bin/bwrap',
+        bwrapArgs: ['--unshare-all', '--setenv', 'FOO', 'bar baz'],
+        command,
+        stagingDir: null
+      })
+    ).toBe(
+      argvLine('/usr/bin/bwrap', '--unshare-all', '--setenv', 'FOO', 'bar baz', '--', '/bin/sh', '-c', command)
+    )
+  })
+
+  it('removes the staging dir on the host after bwrap returns', () => {
+    expect(
+      wrapStartupCommandInBubblewrap({
+        bwrapPath: 'bwrap',
+        bwrapArgs: [],
+        command: 'claude',
+        stagingDir: '/tmp/orca-agent-sandbox/cow-abc'
+      })
+    ).toBe(
+      `${argvLine('bwrap', '--', '/bin/sh', '-c', 'claude')}; rm -rf ${q('/tmp/orca-agent-sandbox/cow-abc')}`
+    )
+  })
+})
+
+describe('prepareAgentSandboxStartupCommand', () => {
+  it('assembles preflight, config, mounts and wrapping', async () => {
+    const command = await prepareAgentSandboxStartupCommand({
+      agent: 'claude',
+      command: 'claude --dangerously-skip-permissions',
+      workdir: '/home/u/ws/repo/feature',
+      env: {},
+      homeDir: HOME,
+      processEnv: { WORKSPACER_CONFIG_DIR: '/cfg', WORKSPACER_HOME_SIZE_MB: '1' },
+      stagingParent: '/unused',
+      deps: {
+        resolveBwrap: async () => '/nix/bin/bwrap',
+        readConfig: (configDir) => ({
+          configDir,
+          env: [{ key: 'FOO', value: 'bar' }],
+          homeMounts: [{ mode: 'rw', source: '/cfg/home_rw/.gitconfig', homeRelativePath: '.gitconfig' }]
+        }),
+        exists: (path) => path === '/nix' || path === '/home/u/.claude',
+        gitCommonDir: () => '/home/u/ws/repo/.git'
+      }
+    })
+    expect(command).toBe(
+      argvLine(
+        '/nix/bin/bwrap',
+        '--unshare-all',
+        '--share-net',
+        '--die-with-parent',
+        '--dev',
+        '/dev',
+        '--proc',
+        '/proc',
+        '--ro-bind',
+        '/sys',
+        '/sys',
+        '--ro-bind',
+        '/nix',
+        '/nix',
+        '--size',
+        String(8192 * 1024 * 1024),
+        '--tmpfs',
+        '/tmp',
+        '--size',
+        String(1024 * 1024),
+        '--tmpfs',
+        '/home/u',
+        '--bind',
+        '/home/u/ws/repo/feature',
+        '/home/u/ws/repo/feature',
+        '--bind',
+        '/home/u/ws/repo/.git',
+        '/home/u/ws/repo/.git',
+        '--chdir',
+        '/home/u/ws/repo/feature',
+        '--setenv',
+        'HOME',
+        '/home/u',
+        '--setenv',
+        'WORKSPACER_SANDBOX',
+        '1',
+        '--setenv',
+        'ORCA_AGENT_SANDBOX',
+        'bwrap',
+        '--bind',
+        '/home/u/.claude',
+        '/home/u/.claude',
+        '--bind',
+        '/cfg/home_rw/.gitconfig',
+        '/home/u/.gitconfig',
+        '--setenv',
+        'FOO',
+        'bar',
+        '--',
+        '/bin/sh',
+        '-c',
+        'claude --dangerously-skip-permissions'
+      )
+    )
+  })
+})
diff --git a/src/main/agent-sandbox/agent-sandbox-launch.ts b/src/main/agent-sandbox/agent-sandbox-launch.ts
new file mode 100644
index 0000000000..7a5e44051f
--- /dev/null
+++ b/src/main/agent-sandbox/agent-sandbox-launch.ts
@@ -0,0 +1,203 @@
+import { cpSync, existsSync, mkdirSync, mkdtempSync, statSync } from 'node:fs'
+import { dirname, join, resolve } from 'node:path'
+import { quoteStartupArg } from '../../shared/tui-agent-startup-shell'
+import type { TuiAgent } from '../../shared/tui-agent'
+import { gitExecFileSync } from '../git/runner'
+import {
+  BUBBLEWRAP_SYSTEM_MOUNT_CANDIDATES,
+  buildBubblewrapArgs,
+  DEFAULT_SANDBOX_HOME_SIZE_MB,
+  DEFAULT_SANDBOX_TMP_SIZE_MB,
+  resolveSandboxSizeMb,
+  type SandboxBindMount
+} from './bubblewrap-args'
+import { resolveBubblewrapExecutable } from './bubblewrap-preflight'
+import {
+  readWorkspacerSandboxConfig,
+  resolveWorkspacerConfigDir,
+  type WorkspacerHomeMount,
+  type WorkspacerSandboxConfig
+} from './workspacer-config'
+
+/** Shell that evaluates the original startup command inside the sandbox; `/bin` is bound from the host. */
+const SANDBOX_COMMAND_SHELL = '/bin/sh'
+
+type PathExists = (path: string) => boolean
+
+/**
+ * Mounts Orca's own integration needs: the hook script resolves through `${HOME}`, and status
+ * hooks plus transcript reading live in the agent's config dir. Applied before user mounts so a
+ * workspacer entry can still override them.
+ */
+export function resolveOrcaSandboxMounts(input: {
+  agent: TuiAgent
+  homeDir: string
+  env: Readonly<Record<string, string | undefined>>
+  exists?: PathExists
+}): SandboxBindMount[] {
+  const exists = input.exists ?? existsSync
+  const candidates: SandboxBindMount[] = [
+    bind('ro', join(input.homeDir, '.orca', 'agent-hooks'))
+  ]
+  if (input.agent === 'claude' || input.agent === 'claude-agent-teams') {
+    candidates.push(
+      bind('rw', input.env.CLAUDE_CONFIG_DIR?.trim() || join(input.homeDir, '.claude')),
+      bind('rw', join(input.homeDir, '.claude.json'))
+    )
+  } else if (input.agent === 'codex') {
+    candidates.push(bind('rw', input.env.CODEX_HOME?.trim() || join(input.homeDir, '.codex')))
+  }
+  return candidates.filter((mount) => exists(mount.source))
+}
+
+function bind(mode: SandboxBindMount['mode'], path: string): SandboxBindMount {
+  return { mode, source: path, target: path }
+}
+
+/**
+ * A worktree's `.git` is a file pointing into the main repo, which must be bound too. Fails
+ * loudly when the backing repo is unavailable rather than dropping the agent into a checkout
+ * where every git command dies with "not a git repository".
+ */
+export function resolveSandboxGitCommonDir(
+  workdir: string,
+  deps: {
+    isFile?: (path: string) => boolean
+    isDirectory?: (path: string) => boolean
+    gitCommonDir?: (workdir: string) => string
+  } = {}
+): string | null {
+  const isFile = deps.isFile ?? ((path: string) => safeStat(path)?.isFile() === true)
+  const isDirectory =
+    deps.isDirectory ?? ((path: string) => safeStat(path)?.isDirectory() === true)
+  if (!isFile(join(workdir, '.git'))) {
+    return null
+  }
+  const unavailable = new Error(
+    `'${workdir}' is a git worktree but its backing repository is unavailable; refusing to launch the sandboxed agent.`
+  )
+  let commonDir: string
+  try {
+    commonDir = (deps.gitCommonDir ?? runGitCommonDir)(workdir).trim()
+  } catch {
+    throw unavailable
+  }
+  const absolute = resolve(workdir, commonDir)
+  if (!commonDir || !isDirectory(absolute)) {
+    throw unavailable
+  }
+  return absolute
+}
+
+function runGitCommonDir(workdir: string): string {
+  return gitExecFileSync(['rev-parse', '--git-common-dir'], { cwd: workdir })
+}
+
+function safeStat(path: string): ReturnType<typeof statSync> | null {
+  try {
+    return statSync(path)
+  } catch {
+    return null
+  }
+}
+
+/** Copies `home_cow` entries into a per-launch staging dir so writes never reach the originals. */
+export function stageCowMounts(
+  mounts: readonly WorkspacerHomeMount[],
+  stagingParent: string,
+  homeDir: string
+): { mounts: SandboxBindMount[]; stagingDir: string | null } {
+  let stagingDir: string | null = null
+  const staged = mounts.map((mount): SandboxBindMount => {
+    const target = join(homeDir, mount.homeRelativePath)
+    if (mount.mode !== 'cow') {
+      return { mode: mount.mode, source: mount.source, target }
+    }
+    if (!stagingDir) {
+      mkdirSync(stagingParent, { recursive: true })
+      stagingDir = mkdtempSync(join(stagingParent, 'cow-'))
+    }
+    const stagedPath = join(stagingDir, mount.homeRelativePath)
+    mkdirSync(dirname(stagedPath), { recursive: true })
+    cpSync(mount.source, stagedPath, { recursive: true, dereference: true, preserveTimestamps: true })
+    return { mode: 'rw', source: stagedPath, target }
+  })
+  return { mounts: staged, stagingDir }
+}
+
+/**
+ * The host's interactive shell evaluates this string, so the sandboxed `/bin/sh -c` re-parses
+ * the original command with the same POSIX quoting it was built for. Staging cleanup rides on
+ * the same line: it runs on the host once bwrap returns.
+ */
+export function wrapStartupCommandInBubblewrap(input: {
+  bwrapPath: string
+  bwrapArgs: readonly string[]
+  command: string
+  stagingDir: string | null
+}): string {
+  const quote = (value: string): string => quoteStartupArg(value, 'posix')
+  const argv = [input.bwrapPath, ...input.bwrapArgs, '--', SANDBOX_COMMAND_SHELL, '-c', input.command]
+  const wrapped = argv.map(quote).join(' ')
+  return input.stagingDir ? `${wrapped}; rm -rf ${quote(input.stagingDir)}` : wrapped
+}
+
+export type AgentSandboxLaunchDeps = {
+  resolveBwrap?: () => Promise<string>
+  readConfig?: (configDir: string) => WorkspacerSandboxConfig
+  exists?: PathExists
+  gitCommonDir?: (workdir: string) => string | null
+}
+
+export async function prepareAgentSandboxStartupCommand(input: {
+  agent: TuiAgent
+  command: string
+  workdir: string
+  /** The PTY's environment, where a managed account pins `CLAUDE_CONFIG_DIR` / `CODEX_HOME`. */
+  env: Readonly<Record<string, string | undefined>>
+  homeDir: string
+  processEnv: NodeJS.ProcessEnv
+  stagingParent: string
+  deps?: AgentSandboxLaunchDeps
+}): Promise<string> {
+  const deps = input.deps ?? {}
+  const exists = deps.exists ?? existsSync
+  const bwrapPath = await (deps.resolveBwrap ?? resolveBubblewrapExecutable)()
+  const config = (deps.readConfig ?? readWorkspacerSandboxConfig)(
+    resolveWorkspacerConfigDir(input.processEnv, input.homeDir)
+  )
+  const gitCommonDir = (deps.gitCommonDir ?? resolveSandboxGitCommonDir)(input.workdir)
+  const { mounts, stagingDir } = stageCowMounts(
+    config.homeMounts,
+    input.stagingParent,
+    input.homeDir
+  )
+  const bwrapArgs = buildBubblewrapArgs({
+    homeDir: input.homeDir,
+    workdir: input.workdir,
+    gitCommonDir,
+    systemMounts: BUBBLEWRAP_SYSTEM_MOUNT_CANDIDATES.filter(exists),
+    tmpSizeMb: resolveSandboxSizeMb(
+      input.processEnv.WORKSPACER_TMP_SIZE_MB,
+      DEFAULT_SANDBOX_TMP_SIZE_MB
+    ),
+    homeSizeMb: resolveSandboxSizeMb(
+      input.processEnv.WORKSPACER_HOME_SIZE_MB,
+      DEFAULT_SANDBOX_HOME_SIZE_MB
+    ),
+    orcaMounts: resolveOrcaSandboxMounts({
+      agent: input.agent,
+      homeDir: input.homeDir,
+      env: input.env,
+      exists
+    }),
+    userHomeMounts: mounts,
+    userEnv: config.env
+  })
+  return wrapStartupCommandInBubblewrap({
+    bwrapPath,
+    bwrapArgs,
+    command: input.command,
+    stagingDir
+  })
+}
